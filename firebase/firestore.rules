rules_version = '2';

// O front não lê nem grava o Firestore: todo acesso passa pelo backend (Admin SDK, que ignora
// estas regras). Tranca tudo — o projectId é público no bundle, e regra aberta aqui expõe
// users/payments/orders pela API REST sem passar pela autorização do servidor.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
