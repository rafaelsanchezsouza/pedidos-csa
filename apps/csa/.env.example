# Firebase (Client SDK)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Admin (Backend)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Evolution API (WhatsApp)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=

# OpenAI
OPENAI_API_KEY=

# Server
PORT=3001

# GitHub (reportar problema)
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=

# Grupo do WhatsApp que vira issue no GitHub (webhook da Evolution). Vazio = webhook desligado.
# O JID sai de: curl localhost:8080/group/fetchAllGroups/<instancia>?getParticipants=false
WHATSAPP_ISSUES_GROUP_JID=
# Prefixo que marca "isto é uma issue" (default: /issue)
WHATSAPP_ISSUES_PREFIX=/issue
# Opcional: exigido no header x-webhook-secret
WHATSAPP_WEBHOOK_SECRET=
